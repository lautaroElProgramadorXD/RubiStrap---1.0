def cargar_app_settings():
    global app_settings
    if os.path.exists(APP_SETTINGS_FILE):
        try:
            with open(APP_SETTINGS_FILE, "r", encoding="utf-8") as f:
                app_settings = json.load(f)
        except Exception:
            app_settings = {"language": None}


def guardar_app_settings():
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(APP_SETTINGS_FILE, "w", encoding="utf-8") as f:
            json.dump(app_settings, f, indent=4)
    except Exception as e:
        print(f"Error guardando settings: {e}")


def get_txt(key):
    lang = app_settings.get("language") or "es"
    lang_dict = TEXTS.get(lang, TEXTS.get("en", TEXTS["es"]))
    return lang_dict.get(key, TEXTS["es"].get(key, key))


def parsear_valor(val):
    if isinstance(val, bool):
        return val
    val_str = str(val).strip()
    val_lower = val_str.lower()
    if val_lower == "true":
        return True
    if val_lower == "false":
        return False
    try:
        return int(val_str)
    except ValueError:
        pass
    try:
        return float(val_str)
    except ValueError:
        pass
    return val_str


# =========================================================
# LOGO VECTORIAL EXACTO BLOXSTRAP (AZUL & CELESTE)
# =========================================================

def dibujar_logo_bloxstrap_exacto(canvas, cx, cy, size=80):
    """
    Dibuja la geometría exacta del logo de Bloxstrap (Pieza Superior e Inferior)
    con un acople de color Azul y Celeste fluído y profesional.
    """
    s = size / 2.0
    hole = s * 0.38      # Proporción del hueco cuadrado central de Roblox
    gap = s * 0.18       # Ancho exacto de la grieta/corte diagonal

    # -------------------------------------------------------------
    # 1. PARTE SUPERIOR (Celeste Brillante / Cyan)
    # -------------------------------------------------------------
    poly_top = [
        (cx - s, cy - gap),
        (cx, cy - s),
        (cx + s, cy - gap),
        (cx + gap, cy - gap),
        (cx + hole, cy - gap),
        (cx, cy - hole - gap),
        (cx - hole, cy - gap),
        (cx - gap, cy - gap)
    ]

    # Borde neón exterior
    canvas.create_polygon(poly_top, fill="#0077ff", outline="#00d2ff", width=2)

    # Cuerpo principal Celeste
    poly_top_inner = [
        (cx - s + 2, cy - gap),
        (cx, cy - s + 3),
        (cx + s - 2, cy - gap),
        (cx + hole - 2, cy - gap),
        (cx, cy - hole - gap + 2),
        (cx - hole + 2, cy - gap)
    ]
    canvas.create_polygon(poly_top_inner, fill="#00d2ff", outline="")

    # -------------------------------------------------------------
    # 2. PARTE INFERIOR (Azul Cobalto / Real)
    # -------------------------------------------------------------
    poly_bottom = [
        (cx - s, cy + gap),
        (cx - gap, cy + gap),
        (cx - hole, cy + gap),
        (cx, cy + hole + gap),
        (cx + hole, cy + gap),
        (cx + gap, cy + gap),
        (cx + s, cy + gap),
        (cx, cy + s)
    ]

    # Borde inferior
    canvas.create_polygon(poly_bottom, fill="#0f34a0", outline="#1a62ff", width=2)

    # Cuerpo principal Azul
    poly_bottom_inner = [
        (cx - s + 2, cy + gap),
        (cx - hole + 2, cy + gap),
        (cx, cy + hole + gap - 2),
        (cx + hole - 2, cy + gap),
        (cx + s - 2, cy + gap),
        (cx, cy + s - 3)
    ]
    canvas.create_polygon(poly_bottom_inner, fill="#1a62ff", outline="")

    # -------------------------------------------------------------
    # 3. LÍNEAS DE BRILLO Y EMPALME
    # -------------------------------------------------------------
    canvas.create_line(cx - s, cy - gap, cx + s, cy - gap, fill="#70e4ff", width=2)
    canvas.create_line(cx - s, cy + gap, cx + s, cy + gap, fill="#4080ff", width=2)


# =========================
# FLAGS MANAGEMENT
# =========================

def cargar_flags():
    global flags
    if not os.path.exists(CONFIG_FILE):
        flags = {}
        actualizar_lista()
        actualizar_home()
        actualizar_settings_ui()
        return

    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as archivo:
            raw_flags = json.load(archivo)
            flags = {k: parsear_valor(v) for k, v in raw_flags.items()}

        actualizar_lista()
        actualizar_home()
        actualizar_settings_ui()
    except Exception as e:
        messagebox.showerror("Error", f"No se pudieron cargar los flags:\n\n{e}")


def guardar_flags():
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(CONFIG_FILE, "w", encoding="utf-8") as archivo:
            json.dump(flags, archivo, indent=4)
        actualizar_home()
        return True
    except Exception as e:
        messagebox.showerror("Error", f"No se pudieron guardar los flags:\n\n{e}")
        return False


def actualizar_lista():
    if 'lista' in globals() and lista.winfo_exists():
        lista.delete(0, tk.END)
        for nombre, valor in flags.items():
            lista.insert(tk.END, f"{nombre} = {valor}")


def agregar_flag():
    ventana = tk.Toplevel(root)
    ventana.title(get_txt("btn_add"))
    ventana.geometry("420x220")
    ventana.resizable(False, False)

    tk.Label(ventana, text="Nombre del Flag:").pack(pady=(15, 5))
    nombre_entry = tk.Entry(ventana, width=50)
    nombre_entry.pack()

    tk.Label(ventana, text="Valor:").pack(pady=(10, 5))
    valor_entry = tk.Entry(ventana, width=50)
    valor_entry.pack()

    def confirmar():
        nombre = nombre_entry.get().strip()
        valor_raw = valor_entry.get().strip()
        if not nombre or not valor_raw:
            messagebox.showwarning("RubiStrap", "Completa todos los campos.")
            return

        flags[nombre] = parsear_valor(valor_raw)
        actualizar_lista()
        actualizar_home()
        actualizar_settings_ui()
        ventana.destroy()

    tk.Button(ventana, text=get_txt("btn_add"), command=confirmar, width=15).pack(pady=20)


def eliminar_flag():
    seleccion = lista.curselection()
    if not seleccion:
        messagebox.showwarning("RubiStrap", "Seleccioná un flag primero.")
        return

    indice = seleccion[0]
    texto = lista.get(indice)
    nombre = texto.split(" = ", 1)[0]

    if nombre in flags:
        del flags[nombre]

    actualizar_lista()
    actualizar_home()
    actualizar_settings_ui()


def guardar():
    if guardar_flags():
        messagebox.showinfo("RubiStrap", "OK!")


# =========================
# BUSCAR & LANZAR ROBLOX
# =========================

def buscar_roblox():
    local_appdata = os.environ.get("LOCALAPPDATA")
    if not local_appdata:
        return None
    versions_dir = os.path.join(local_appdata, "Roblox", "Versions")
    if not os.path.exists(versions_dir):
        return None

    candidatos = glob.glob(os.path.join(versions_dir, "*", "RobloxPlayerBeta.exe"))
    if not candidatos:
        return None

    candidatos.sort(key=lambda archivo: os.path.getmtime(archivo), reverse=True)
    return candidatos[0]


def guardar_client_settings(roblox_exe):
    version_dir = os.path.dirname(roblox_exe)
    client_settings_dir = os.path.join(version_dir, "ClientSettings")
    client_settings_file = os.path.join(client_settings_dir, "ClientAppSettings.json")
    os.makedirs(client_settings_dir, exist_ok=True)

    with open(client_settings_file, "w", encoding="utf-8") as archivo:
        json.dump(flags, archivo, indent=4)

    return client_settings_file


def guardar_y_lanzar():
    terminal = tk.Toplevel(root)
    terminal.title("RubiStrap - Launch")
    terminal.geometry("650x400")
    terminal.configure(bg="black")

    texto = tk.Text(terminal, bg="black", fg="#00ff66", insertbackground="#00ff66", font=("Consolas", 10))
    texto.pack(fill="both", expand=True, padx=10, pady=10)

    def escribir(mensaje):
        texto.insert(tk.END, mensaje + "\n")
        texto.see(tk.END)
        terminal.update()

    escribir("[RubiStrap] Iniciando...")
    time.sleep(0.3)
    roblox_exe = buscar_roblox()

    if not roblox_exe:
        escribir("[ERROR] No se encontró RobloxPlayerBeta.exe.")
        messagebox.showerror("RubiStrap", "No se encontró Roblox Player.")
        return

    escribir(f"[OK] Roblox encontrado:\n{roblox_exe}")
    time.sleep(0.3)

    try:
        client_file = guardar_client_settings(roblox_exe)
        escribir(f"[OK] ClientAppSettings.json guardado:\n{client_file}")
    except Exception as e:
        escribir(f"[ERROR] {e}")
        return

    time.sleep(0.5)
    escribir("[RubiStrap] Lanzando Roblox Player...")

    try:
        subprocess.Popen([roblox_exe], cwd=os.path.dirname(roblox_exe))
        escribir("[OK] Roblox Player iniciado.")
    except Exception as e:
        escribir(f"[ERROR] {e}")


# =========================
# VISTAS DE LA INTERFAZ
# =========================

def actualizar_home():
    if 'home_frame' not in globals() or not home_frame.winfo_exists():
        return

    roblox_exe = buscar_roblox()
    if roblox_exe:
        roblox_estado.config(text=get_txt("roblox_ok"), fg="#55e68a")
    else:
        roblox_estado.config(text=get_txt("roblox_no"), fg="#ff6b6b")

    flags_estado.config(text=f"{get_txt('flags_loaded')}{len(flags)}")

    if os.path.exists(CONFIG_FILE):
        config_estado.config(text=get_txt("config_ok"), fg="#55e68a")
    else:
        config_estado.config(text=get_txt("config_no"), fg="#f0c674")


def mostrar_pantalla(pantalla):
    home_frame.pack_forget()
    editor_frame.pack_forget()
    settings_frame.pack_forget()

    if pantalla == "home":
        home_frame.pack(fill="both", expand=True)
        actualizar_home()
    elif pantalla == "editor":
        editor_frame.pack(fill="both", expand=True)
        actualizar_lista()
    elif pantalla == "settings":
        settings_frame.pack(fill="both", expand=True)
        actualizar_settings_ui()


def reconstruir_ui():
    btn_home.config(text=get_txt("nav_home"))
    btn_editor.config(text=get_txt("nav_editor"))
    btn_settings.config(text=get_txt("nav_settings"))
    btn_lang.config(text=get_txt("nav_lang"))

    lbl_home_sub.config(text=get_txt("welcome_sub"))
    lbl_status_title.config(text=get_txt("status_title"))
    btn_home_editor.config(text=get_txt("btn_editor"))

    lbl_editor_title.config(text=get_txt("editor_title"))
    lbl_editor_sub.config(text=get_txt("editor_sub"))
    btn_add_flag.config(text=get_txt("btn_add"))
    btn_del_flag.config(text=get_txt("btn_del"))
    btn_save_flag.config(text=get_txt("btn_save"))
    btn_launch_game.config(text=get_txt("btn_launch"))

    lbl_settings_title.config(text=get_txt("settings_title"))
    lbl_settings_sub.config(text=get_txt("settings_sub"))
    lbl_presets_title.config(text=get_txt("presets_title"))
    btn_preset_max.config(text=get_txt("preset_max"))
    btn_preset_bal.config(text=get_txt("preset_bal"))
    btn_preset_qual.config(text=get_txt("preset_qual"))
    lbl_fps_title.config(text=get_txt("fps_title"))
    lbl_gfx_title.config(text=get_txt("gfx_title"))

    chk_sky.config(text=get_txt("chk_sky"))
    chk_postfx.config(text=get_txt("chk_postfx"))
    chk_shadows.config(text=get_txt("chk_shadows"))
    chk_bloom.config(text=get_txt("chk_bloom"))

    actualizar_home()


def confirmar_idioma_y_entrar():
    idioma_seleccionado = combo_idiomas.get()
    code = LANGUAGES.get(idioma_seleccionado, "es")

    app_settings["language"] = code
    guardar_app_settings()

    lang_screen_frame.pack_forget()
    sidebar.pack(side="left", fill="y")
    contenido.pack(side="right", fill="both", expand=True)

    reconstruir_ui()
    mostrar_pantalla("home")


def cambiar_idioma_desde_menu():
    contenido.pack_forget()
    sidebar.pack_forget()
    lang_screen_frame.pack(fill="both", expand=True)


def filtrar_idiomas(event):
    typed = entry_search.get().strip().lower()
    if not typed:
        combo_idiomas['values'] = list(LANGUAGES.keys())
    else:
        filtrados = [lang for lang in LANGUAGES.keys() if typed in lang.lower()]
        combo_idiomas['values'] = filtrados
        if filtrados:
            combo_idiomas.set(filtrados[0])


def crear_pantalla_idioma():
    global lang_screen_frame, combo_idiomas, entry_search

    lang_screen_frame = tk.Frame(root, bg="#111116")

    canvas_logo = tk.Canvas(lang_screen_frame, width=500, height=120, bg="#111116", highlightthickness=0)
    canvas_logo.pack(pady=(40, 10))

    # Rejilla decorativa suave de fondo
    for x in range(0, 500, 25):
        canvas_logo.create_line(x, 0, x, 120, fill="#1a1a24", width=1)
    for y in range(0, 120, 25):
        canvas_logo.create_line(0, y, 500, y, fill="#1a1a24", width=1)

    # DIBUJO DEL LOGO AZUL Y CELESTE EXACTO
    dibujar_logo_bloxstrap_exacto(canvas_logo, 60, 60, size=85)

    canvas_logo.create_text(310, 48, text="RUBISTRAP", fill="#ffffff", font=("Segoe UI", 32, "bold"))
    canvas_logo.create_text(295, 82, text="NEXT GEN ROBLOX BOOSTER", fill="#00d2ff", font=("Segoe UI", 10, "bold"))

    tk.Label(
        lang_screen_frame,
        text="Select Language / Selecciona tu idioma / 言語を選択:",
        bg="#111116", fg="#ffffff", font=("Segoe UI", 12, "bold")
    ).pack(pady=(10, 8))

    tk.Label(
        lang_screen_frame,
        text="🔍 Buscar / Search / 検索:",
        bg="#111116", fg="#a8a8a8", font=("Segoe UI", 9)
    ).pack(pady=(0, 2))

    entry_search = tk.Entry(lang_screen_frame, bg="#22222b", fg="white", insertbackground="white", font=("Segoe UI", 10), width=32, relief="flat")
    entry_search.pack(pady=(0, 10))
    entry_search.bind("<KeyRelease>", filtrar_idiomas)

    combo_idiomas = ttk.Combobox(
        lang_screen_frame,
        values=list(LANGUAGES.keys()),
        state="readonly",
        font=("Segoe UI", 10),
        width=35,
        height=12
    )
    combo_idiomas.set("Español")
    combo_idiomas.pack(pady=(0, 20))

    tk.Button(
        lang_screen_frame, text="CONTINUAR / CONTINUE / 続行", command=confirmar_idioma_y_entrar,
        bg="#0077ff", fg="white", activebackground="#0055cc", font=("Segoe UI", 11, "bold"),
        width=28, height=2, relief="flat", cursor="hand2"
    ).pack()


def crear_home():
