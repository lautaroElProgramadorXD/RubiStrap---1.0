    canvas_banner.create_text(240, 82, text="NEXT GEN ROBLOX BOOSTER", fill="#00d2ff", font=("Segoe UI", 10, "bold"))

    lbl_home_sub = tk.Label(home_frame, text=get_txt("welcome_sub"), bg="#181818", fg="#a8a8a8", font=("Segoe UI", 11))
    lbl_home_sub.pack(anchor="w", padx=35)

    estado_box = tk.Frame(home_frame, bg="#222222")
    estado_box.pack(fill="x", padx=35, pady=20)

    lbl_status_title = tk.Label(estado_box, text=get_txt("status_title"), bg="#222222", fg="white", font=("Segoe UI", 14, "bold"))
    lbl_status_title.pack(anchor="w", padx=20, pady=(15, 8))

    roblox_estado = tk.Label(estado_box, text="", bg="#222222", fg="#55e68a", font=("Segoe UI", 11))
    roblox_estado.pack(anchor="w", padx=20, pady=3)

    flags_estado = tk.Label(estado_box, text="", bg="#222222", fg="#dddddd", font=("Segoe UI", 11))
    flags_estado.pack(anchor="w", padx=20, pady=3)

    config_estado = tk.Label(estado_box, text="", bg="#222222", fg="#dddddd", font=("Segoe UI", 11))
    config_estado.pack(anchor="w", padx=20, pady=(3, 15))

    btn_home_editor = tk.Button(
        home_frame, text=get_txt("btn_editor"), command=lambda: mostrar_pantalla("editor"),
        bg="#0077ff", fg="white", activebackground="#0055cc", relief="flat", font=("Segoe UI", 11, "bold"), padx=20, pady=10, cursor="hand2"
    )
    btn_home_editor.pack(anchor="w", padx=35)


def crear_editor():
    global editor_frame, lista
    global lbl_editor_title, lbl_editor_sub, btn_add_flag, btn_del_flag, btn_save_flag, btn_launch_game

    editor_frame = tk.Frame(contenido, bg="#181818")

    lbl_editor_title = tk.Label(editor_frame, text=get_txt("editor_title"), bg="#181818", fg="white", font=("Segoe UI", 24, "bold"))
    lbl_editor_title.pack(anchor="w", padx=35, pady=(25, 3))

    lbl_editor_sub = tk.Label(editor_frame, text=get_txt("editor_sub"), bg="#181818", fg="#a8a8a8", font=("Segoe UI", 11))
    lbl_editor_sub.pack(anchor="w", padx=35, pady=(0, 10))

    lista = tk.Listbox(editor_frame, width=75, height=13, bg="#222222", fg="#eeeeee", selectbackground="#0077ff", selectforeground="white", font=("Consolas", 10), relief="flat", highlightthickness=0)
    lista.pack(padx=35, pady=10, fill="both", expand=True)

    frame_botones = tk.Frame(editor_frame, bg="#181818")
    frame_botones.pack(pady=10)

    btn_add_flag = tk.Button(frame_botones, text=get_txt("btn_add"), command=agregar_flag, width=15, relief="flat")
    btn_add_flag.grid(row=0, column=0, padx=5)

    btn_del_flag = tk.Button(frame_botones, text=get_txt("btn_del"), command=eliminar_flag, width=15, relief="flat")
    btn_del_flag.grid(row=0, column=1, padx=5)

    btn_save_flag = tk.Button(frame_botones, text=get_txt("btn_save"), command=guardar, width=15, relief="flat")
    btn_save_flag.grid(row=0, column=2, padx=5)

    btn_launch_game = tk.Button(
        editor_frame, text=get_txt("btn_launch"), command=guardar_y_lanzar, width=35, height=2,
        bg="#0077ff", fg="white", activebackground="#0055cc", relief="flat", font=("Segoe UI", 10, "bold"), cursor="hand2"
    )
    btn_launch_game.pack(pady=(5, 20))


def crear_settings():
    global settings_frame
    global var_sky, var_postfx, var_shadows, var_bloom
    global lbl_settings_title, lbl_settings_sub, lbl_presets_title, btn_preset_max, btn_preset_bal, btn_preset_qual
    global lbl_fps_title, lbl_gfx_title, chk_sky, chk_postfx, chk_shadows, chk_bloom

    settings_frame = tk.Frame(contenido, bg="#181818")

    lbl_settings_title = tk.Label(settings_frame, text=get_txt("settings_title"), bg="#181818", fg="white", font=("Segoe UI", 24, "bold"))
    lbl_settings_title.pack(anchor="w", padx=35, pady=(25, 3))

    lbl_settings_sub = tk.Label(settings_frame, text=get_txt("settings_sub"), bg="#181818", fg="#a8a8a8", font=("Segoe UI", 11))
    lbl_settings_sub.pack(anchor="w", padx=35, pady=(0, 10))

    # Presets
    presets_box = tk.Frame(settings_frame, bg="#222222")
    presets_box.pack(fill="x", padx=35, pady=8)

    lbl_presets_title = tk.Label(presets_box, text=get_txt("presets_title"), bg="#222222", fg="white", font=("Segoe UI", 12, "bold"))
    lbl_presets_title.pack(anchor="w", padx=20, pady=(12, 5))

    frame_presets_btn = tk.Frame(presets_box, bg="#222222")
    frame_presets_btn.pack(anchor="w", padx=20, pady=(0, 12))

    def aplicar_perfil(tipo):
        if tipo == "max":
            flags["FFlagDebugSkyGray"] = True
            flags["FFlagDisablePostFx"] = True
            flags["FIntRenderShadowIntensity"] = 0
            flags["FFlagEnableBloomEffect"] = False
            flags["DFIntTaskSchedulerTargetFps"] = 999
        elif tipo == "equilibrado":
            flags["FFlagDebugSkyGray"] = False
            flags["FFlagDisablePostFx"] = True
            flags["FIntRenderShadowIntensity"] = 0
            flags["FFlagEnableBloomEffect"] = False
            flags["DFIntTaskSchedulerTargetFps"] = 144
        elif tipo == "calidad":
            flags.pop("FFlagDebugSkyGray", None)
            flags.pop("FFlagDisablePostFx", None)
            flags.pop("FIntRenderShadowIntensity", None)
            flags.pop("FFlagEnableBloomEffect", None)
            flags["DFIntTaskSchedulerTargetFps"] = 60

        guardar_flags()
        actualizar_settings_ui()
        messagebox.showinfo("RubiStrap", f"Perfil '{tipo.capitalize()}' OK!")

    btn_preset_max = tk.Button(frame_presets_btn, text=get_txt("preset_max"), command=lambda: aplicar_perfil("max"), bg="#0077ff", fg="white", relief="flat", font=("Segoe UI", 9, "bold"), padx=10, pady=5, cursor="hand2")
    btn_preset_max.pack(side="left", padx=4)

    btn_preset_bal = tk.Button(frame_presets_btn, text=get_txt("preset_bal"), command=lambda: aplicar_perfil("equilibrado"), bg="#333333", fg="white", relief="flat", font=("Segoe UI", 9, "bold"), padx=10, pady=5, cursor="hand2")
    btn_preset_bal.pack(side="left", padx=4)

    btn_preset_qual = tk.Button(frame_presets_btn, text=get_txt("preset_qual"), command=lambda: aplicar_perfil("calidad"), bg="#333333", fg="white", relief="flat", font=("Segoe UI", 9, "bold"), padx=10, pady=5, cursor="hand2")
    btn_preset_qual.pack(side="left", padx=4)

    # FPS
    fps_box = tk.Frame(settings_frame, bg="#222222")
    fps_box.pack(fill="x", padx=35, pady=8)

    lbl_fps_title = tk.Label(fps_box, text=get_txt("fps_title"), bg="#222222", fg="white", font=("Segoe UI", 12, "bold"))
    lbl_fps_title.pack(anchor="w", padx=20, pady=(12, 5))

    frame_fps_btn = tk.Frame(fps_box, bg="#222222")
    frame_fps_btn.pack(anchor="w", padx=20, pady=(0, 12))

    def fijar_fps(valor):
        flags["DFIntTaskSchedulerTargetFps"] = int(valor)
        guardar_flags()
        messagebox.showinfo("RubiStrap", f"FPS: {valor}")

    for fps in [60, 120, 144, 240, 999]:
        etiqueta = f"{fps} FPS" if fps != 999 else "MAX"
        tk.Button(frame_fps_btn, text=etiqueta, command=lambda v=fps: fijar_fps(v), bg="#0077ff", fg="white", relief="flat", font=("Segoe UI", 9, "bold"), padx=10, pady=5, cursor="hand2").pack(side="left", padx=4)

    # Gráficos
    graficos_box = tk.Frame(settings_frame, bg="#222222")
    graficos_box.pack(fill="x", padx=35, pady=8)

    lbl_gfx_title = tk.Label(graficos_box, text=get_txt("gfx_title"), bg="#222222", fg="white", font=("Segoe UI", 12, "bold"))
    lbl_gfx_title.pack(anchor="w", padx=20, pady=(12, 8))

    var_sky = tk.BooleanVar()
    var_postfx = tk.BooleanVar()
    var_shadows = tk.BooleanVar()
    var_bloom = tk.BooleanVar()

    def toggle_sky():
        flags["FFlagDebugSkyGray"] = var_sky.get()
        guardar_flags()

    def toggle_postfx():
        flags["FFlagDisablePostFx"] = var_postfx.get()
        guardar_flags()

    def toggle_shadows():
        if var_shadows.get():
            flags["FIntRenderShadowIntensity"] = 0
        else:
            flags.pop("FIntRenderShadowIntensity", None)
        guardar_flags()

    def toggle_bloom():
        flags["FFlagEnableBloomEffect"] = not var_bloom.get()
        guardar_flags()

    chk_sky = tk.Checkbutton(graficos_box, text=get_txt("chk_sky"), variable=var_sky, command=toggle_sky, bg="#222222", fg="white", selectcolor="#181818", activebackground="#222222", activeforeground="white", font=("Segoe UI", 10))
    chk_sky.pack(anchor="w", padx=20, pady=2)

    chk_postfx = tk.Checkbutton(graficos_box, text=get_txt("chk_postfx"), variable=var_postfx, command=toggle_postfx, bg="#222222", fg="white", selectcolor="#181818", activebackground="#222222", activeforeground="white", font=("Segoe UI", 10))
    chk_postfx.pack(anchor="w", padx=20, pady=2)

    chk_shadows = tk.Checkbutton(graficos_box, text=get_txt("chk_shadows"), variable=var_shadows, command=toggle_shadows, bg="#222222", fg="white", selectcolor="#181818", activebackground="#222222", activeforeground="white", font=("Segoe UI", 10))
    chk_shadows.pack(anchor="w", padx=20, pady=2)

    chk_bloom = tk.Checkbutton(graficos_box, text=get_txt("chk_bloom"), variable=var_bloom, command=toggle_bloom, bg="#222222", fg="white", selectcolor="#181818", activebackground="#222222", activeforeground="white", font=("Segoe UI", 10))
    chk_bloom.pack(anchor="w", padx=20, pady=(2, 12))


def actualizar_settings_ui():
    if 'var_sky' in globals():
        var_sky.set(bool(flags.get("FFlagDebugSkyGray", False)))
        var_postfx.set(bool(flags.get("FFlagDisablePostFx", False)))
        var_shadows.set(flags.get("FIntRenderShadowIntensity") == 0)
        var_bloom.set(flags.get("FFlagEnableBloomEffect") == False)


# =========================
# VENTANA PRINCIPAL
# =========================

root = tk.Tk()
root.title("RubiStrap")
root.geometry("900x600")
root.resizable(False, False)
root.configure(bg="#181818")

cargar_app_settings()

crear_pantalla_idioma()

# SIDEBAR
sidebar = tk.Frame(root, bg="#111111", width=190)
sidebar.pack_propagate(False)

tk.Label(sidebar, text="💎 RubiStrap", bg="#111111", fg="white", font=("Segoe UI", 17, "bold")).pack(pady=(30, 35))

btn_home = tk.Button(sidebar, text=get_txt("nav_home"), command=lambda: mostrar_pantalla("home"), bg="#111111", fg="white", activebackground="#292929", activeforeground="white", relief="flat", anchor="w", font=("Segoe UI", 11), padx=20, pady=12, cursor="hand2")
btn_home.pack(fill="x")

btn_editor = tk.Button(sidebar, text=get_txt("nav_editor"), command=lambda: mostrar_pantalla("editor"), bg="#111111", fg="white", activebackground="#292929", activeforeground="white", relief="flat", anchor="w", font=("Segoe UI", 11), padx=20, pady=12, cursor="hand2")
btn_editor.pack(fill="x")

btn_settings = tk.Button(sidebar, text=get_txt("nav_settings"), command=lambda: mostrar_pantalla("settings"), bg="#111111", fg="white", activebackground="#292929", activeforeground="white", relief="flat", anchor="w", font=("Segoe UI", 11), padx=20, pady=12, cursor="hand2")
btn_settings.pack(fill="x")

btn_lang = tk.Button(sidebar, text=get_txt("nav_lang"), command=cambiar_idioma_desde_menu, bg="#111111", fg="white", activebackground="#292929", activeforeground="white", relief="flat", anchor="w", font=("Segoe UI", 11), padx=20, pady=12, cursor="hand2")
btn_lang.pack(fill="x")

tk.Label(sidebar, text="RubiStrap v0.8", bg="#111111", fg="#777777", font=("Segoe UI", 9)).pack(side="bottom", pady=20)

# CONTENIDO PRINCIPAL
contenido = tk.Frame(root, bg="#181818")

crear_home()
crear_editor()
crear_settings()

cargar_flags()

# CONTROL DE FLUJO AL INICIAR
if not app_settings.get("language"):
    lang_screen_frame.pack(fill="both", expand=True)
else:
    sidebar.pack(side="left", fill="y")
    contenido.pack(side="right", fill="both", expand=True)
    mostrar_pantalla("home")

root.mainloop()